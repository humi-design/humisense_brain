# Deployment environment for ops/compose/docker-compose.yml.
#
# Copy to `ops/compose/.env` (git-ignored) and replace every value marked CHANGE-ME.
# This file is committed and must never contain a real credential.
#
# Generate the random values with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# The API refuses to start with an insecure production configuration, so a placeholder
# value that fails a check is a startup error, not a silent weakness.

# --- Image tag ---------------------------------------------------------------
# Set to a release tag (for example `0.1.0`) so a deployment pins an exact artifact.
HUMISENSE_IMAGE_TAG=CHANGE-ME

# --- Database ----------------------------------------------------------------
# The superuser password is used only on first boot to create the application role.
POSTGRES_SUPERUSER_PASSWORD=CHANGE-ME-strong-random
# The application role's password. The app connects with this role, never the superuser.
HUMISENSE_APP_PASSWORD=CHANGE-ME-strong-random
#
# Database TLS is not configurable here. The reference stack runs the API in production
# mode, which requires verified TLS, so docker-compose.yml pins DATABASE_REQUIRE_TLS=true
# and points DATABASE_TLS_CA_PATH at the CA the `tls` service generates. A real deployment
# replaces that service with certificates from its own CA; see docs/DEPLOYMENT.md. To
# evaluate the stack locally without TLS you must run the API in development mode, which
# is a different configuration and is never production-ready.

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE-ME-strong-random

# --- Authentication ----------------------------------------------------------
# `oidc` is the only mode accepted in production.
AUTH_MODE=oidc
OIDC_ISSUER=https://CHANGE-ME.example.com/realms/humisense
OIDC_AUDIENCE=humisense-brain
OIDC_JWKS_URL=https://CHANGE-ME.example.com/realms/humisense/protocol/openid-connect/certs
# At least 32 random characters. Rotating it invalidates every existing session.
SESSION_SECRET=CHANGE-ME-at-least-32-random-characters

# --- Secrets provider --------------------------------------------------------
SECRETS_PROVIDER=encrypted_db
# Base64 of exactly 32 random bytes. Losing this makes stored connector credentials
# unrecoverable; back it up in the secret manager, not in the repository.
SECRETS_MASTER_KEY=CHANGE-ME-base64-of-32-random-bytes

# --- CORS --------------------------------------------------------------------
# The exact https origin the browser uses. A wildcard is refused in production.
CORS_ORIGINS=https://CHANGE-ME.example.com
# One reverse proxy (the frontend nginx, or the TLS terminator) sits in front of the API.
TRUSTED_PROXY_COUNT=1

# --- Layer 2 handoff ---------------------------------------------------------
# disabled | http. `local_test_receiver` is refused in production.
LAYER2_MODE=disabled
LAYER2_BASE_URL=
LAYER2_BEARER_TOKEN=

# --- Egress policy -----------------------------------------------------------
# Comma-separated allowlist of hostnames or CIDRs connectors may reach. Empty means
# public destinations only.
EGRESS_ALLOWED_HOSTS=
EGRESS_ALLOW_PRIVATE_NETWORKS=false

# --- Frontend ----------------------------------------------------------------
# The host loopback port the frontend binds. A TLS-terminating proxy fronts it.
FRONTEND_PORT=8080

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
