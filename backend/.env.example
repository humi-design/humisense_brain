# Humisense Brain / OS - environment template.
#
# Copy to `.env` and replace every placeholder. This file is committed, so it must never
# contain a real credential. `.env` is git-ignored.

# --- Core ---------------------------------------------------------------------
APP_NAME="Humisense Brain / OS"
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ----------------------------------------------------------------
# The application connects as a non-superuser role so Row-Level Security applies.
DATABASE_URL=postgresql+asyncpg://humisense_app:change-me@localhost:5432/humisense
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
# Required in production.
DATABASE_REQUIRE_TLS=false

# --- Redis (background jobs) -------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Authentication ----------------------------------------------------------
# dev | oidc. `dev` is refused when APP_ENV=production.
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256,ES256
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
COOKIE_SECURE=false

# --- CORS --------------------------------------------------------------------
# Comma-separated, explicit origins. A wildcard is refused in production.
CORS_ORIGINS=http://localhost:5173
TRUSTED_PROXY_COUNT=0

# --- Secrets provider --------------------------------------------------------
# env | encrypted_db. Production refuses `env` unless SECRETS_ALLOW_ENV_PROVIDER=true.
SECRETS_PROVIDER=encrypted_db
# Base64 of exactly 32 random bytes. Generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_MASTER_KEY=replace-with-base64-of-32-random-bytes
SECRETS_ENV_PREFIX=HUMISENSE_SECRET_
SECRETS_ALLOW_ENV_PROVIDER=false

# --- Egress / SSRF policy ----------------------------------------------------
# Comma-separated allowlist of hostnames or CIDRs connectors may reach.
EGRESS_ALLOWED_HOSTS=
EGRESS_ALLOW_PRIVATE_NETWORKS=false
EGRESS_ALLOW_INSECURE_HTTP=false
EGRESS_CONNECT_TIMEOUT_SECONDS=5
EGRESS_READ_TIMEOUT_SECONDS=20
EGRESS_MAX_RESPONSE_BYTES=8388608
EGRESS_MAX_REDIRECTS=2

# --- CSV connector -----------------------------------------------------------
# Comma-separated list of directories the CSV connector may read.
CSV_ALLOWED_ROOTS=./data/synthetic
CSV_MAX_FILE_BYTES=67108864
CSV_MAX_ROWS=1000000
CSV_MAX_PROCESSING_SECONDS=120
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_BYTES=33554432

# --- Layer 2 handoff ---------------------------------------------------------
# disabled | local_test_receiver | http. The test receiver is refused in production.
LAYER2_MODE=local_test_receiver
LAYER2_BASE_URL=
LAYER2_BEARER_TOKEN=
LAYER2_TIMEOUT_SECONDS=10
LAYER2_MAX_ATTEMPTS=4

# --- Resource protection -----------------------------------------------------
RATE_LIMIT_ENABLED=true
# arq | inline. `inline` runs sync work in the API process and is refused in production.
TASK_QUEUE_MODE=arq
RATE_LIMIT_SYNC_PER_HOUR=60
RATE_LIMIT_WRITES_PER_MINUTE=120
RATE_LIMIT_TESTS_PER_MINUTE=30
MAX_REQUEST_BODY_BYTES=1048576
MAX_PAGE_SIZE=200
SYNC_BATCH_SIZE=500
SYNC_MAX_CONCURRENT_JOBS_PER_TENANT=3

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
# Leave unset: defaults to false in production and true elsewhere.
DOCS_ENABLED=
OTEL_ENABLED=false
OTEL_ENDPOINT=
